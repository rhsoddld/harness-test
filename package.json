{
  "name": "harness-test",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-first harness engineering scaffold with docs, worktree workflow, and Husky hooks.",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "validate": "npm run validate:docs && npm run validate:links && npm run validate:naming",
    "validate:docs": "node scripts/validate-docs.mjs",
    "validate:links": "node scripts/validate-links.mjs",
    "validate:naming": "node scripts/validate-naming.mjs",
    "validate:commit-msg": "node scripts/validate-commit-msg.mjs",
    "prd:create": "node scripts/create-prd.mjs",
    "prd:run": "node scripts/codex-from-prd.mjs"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  },
  "engines": {
    "node": ">=20"
  }
}

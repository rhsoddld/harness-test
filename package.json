{
  "name": "harness-test",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-first harness engineering scaffold with docs, worktree workflow, and Husky hooks.",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "validate": "npm run validate:docs && npm run validate:links && npm run validate:naming && npm run validate:workstreams && npm run validate:skills && npm run validate:rules && npm run validate:context && npm run validate:lifecycle",
    "validate:docs": "node scripts/validate-docs.mjs",
    "validate:links": "node scripts/validate-links.mjs",
    "validate:naming": "node scripts/validate-naming.mjs",
    "validate:commit-msg": "node scripts/validate-commit-msg.mjs",
    "prd:create": "node scripts/create-prd.mjs",
    "prd:run": "node scripts/codex-from-prd.mjs",
    "validate:workstreams": "node scripts/validate-workstreams.mjs",
    "validate:lifecycle": "node scripts/validate-lifecycle.mjs",
    "pr:prepare": "node scripts/prepare-pr.mjs",
    "pr:publish": "node scripts/publish-pr.mjs",
    "lifecycle:finalize": "node scripts/finalize-run.mjs",
    "validate:skills": "node scripts/validate-skills.mjs",
    "validate:rules": "node scripts/validate-rule-files.mjs",
    "validate:context": "node scripts/validate-context.mjs"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  },
  "engines": {
    "node": ">=20"
  }
}
